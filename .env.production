##
## Shopzy — Production Environment
## ─────────────────────────────────────────────────────────────────────
## Fill in every value marked with  ← EDIT  before running the app.
## Then run:  php artisan key:generate
##            php artisan migrate   (or import database/shopzy_full.sql)
##            php artisan storage:link
## ─────────────────────────────────────────────────────────────────────

APP_NAME=Shopzy
APP_ENV=production
APP_KEY=                          # ← Run: php artisan key:generate (REQUIRED)
APP_DEBUG=false
APP_URL=https://yourdomain.com    # ← EDIT: your real domain (https)

# ─── Security ──────────────────────────────────────────────────────────────
# Prevent IP spoofing. If using Cloudflare or shared hosting with a proxy, set this to '*'.
# If you are on a direct VPS with no proxy, set this to '127.0.0.1'.
TRUSTED_PROXIES=*                 # ← EDIT: Set based on your server setup

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ──────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_db_name          # ← EDIT: cPanel database name
DB_USERNAME=your_db_user          # ← EDIT: cPanel database user
DB_PASSWORD=your_db_password      # ← EDIT: cPanel database password

# ─── Session ───────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com    # ← EDIT: .yourdomain.com (with leading dot)
SESSION_SECURE_COOKIE=true

# ─── Cache / Queue ──────────────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Mail ───────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.yourdomain.com     # ← EDIT: your SMTP host
MAIL_PORT=587
MAIL_USERNAME=no-reply@yourdomain.com  # ← EDIT
MAIL_PASSWORD=                    # ← EDIT: your SMTP password
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"  # ← EDIT
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS S3 (optional) ──────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Courier APIs (optional) ────────────────────────────────────────────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=

REDX_API_TOKEN=

# Webhook security — set a strong random string, same in courier dashboard.
COURIER_WEBHOOK_SECRET=           # ← EDIT: REQUIRED FOR PRODUCTION SECURITY

# ─── Testing Mode ───────────────────────────────────────────────────────────
TESTING_MODE=false
TESTING_ADMIN_EMAIL=admin@yourdomain.com
TESTING_ADMIN_PASSWORD=changeme

# ─── Vite ────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
